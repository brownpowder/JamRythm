{
  "sourceLanguage": "ja",
  "strings": {
    "(%lld)": {
      "comment": "A small text indicating the number of sections in the current project.",
      "isCommentAutoGenerated": true
    },
    "/%@": {
      "comment": "A button representing a note. The text inside the button is the note name, with a slash followed by the octave number in parentheses. The button is styled to be circular with a white background when selected, and a",
      "isCommentAutoGenerated": true
    },
    "%@": {
      "comment": "A label displaying the key signature of a project. The text inside the parentheses is the raw value of the key signature enum case.",
      "isCommentAutoGenerated": true
    },
    "%@ で全てロック解除": {},
    "%lld": {
      "comment": "A label displaying the measure number and the active chord of a given measure. The first argument is the measure number (starting from 1). The second argument is the name of the active chord in that measure.",
      "isCommentAutoGenerated": true
    },
    "%lld BPM": {
      "comment": "A label showing the beats per minute (BPM) of a project",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld: %@": {
      "comment": "Displays the current voicing index and name.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld: %3$@"
          }
        }
      }
    },
    "%lldf": {
      "comment": "A label displaying a fret number, formatted as a string followed by an \"f\" suffix. The argument is the fret number to be displayed.",
      "isCommentAutoGenerated": true
    },
    "%lldfr": {
      "comment": "A label displaying the starting fret number on the fretboard. The text inside the label is the starting fret number.",
      "isCommentAutoGenerated": true
    },
    "→": {},
    "×": {
      "comment": "A marker representing a muted string.",
      "isCommentAutoGenerated": true
    },
    "○": {
